# ============================================================
# Monsoon Chess Knockout Manager — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.
# ============================================================

# ----------------------------------------------------------
# Supabase — Required
# Find these in: Supabase Dashboard → Project Settings → API
# ----------------------------------------------------------

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Your Supabase anonymous public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_THIS_WITH_YOUR_REAL_ANON_KEY

# ----------------------------------------------------------
# Optional: Service Role Key — Only for server-side admin ops
# WARNING: NEVER prefix with NEXT_PUBLIC_ — server only!
# ----------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_IF_NEEDED
